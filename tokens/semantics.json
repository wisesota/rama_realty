{
  "semantic": {
    "surface": {
      "canvas": { "$value": "{color.gallery}", "$type": "color", "$description": "Main viewport canvas surface" },
      "card": { "$value": "{color.paper}", "$type": "color", "$description": "Default container surface" },
      "subtle": { "$value": "{color.architecture}", "$type": "color", "$description": "Secondary or elevated subtle surface" },
      "wash": { "$value": "{color.sky-wash}", "$type": "color", "$description": "Accented tint surface" }
    },
    "text": {
      "primary": { "$value": "{color.ink}", "$type": "color", "$description": "Primary high-contrast text" },
      "body": { "$value": "{color.body-copy}", "$type": "color", "$description": "Long-form editorial body copy" },
      "muted": { "$value": "{color.quiet}", "$type": "color", "$description": "Secondary supporting text" },
      "inverse": { "$value": "#ffffff", "$type": "color", "$description": "Text on dark background" }
    },
    "border": {
      "subtle": { "$value": "{color.rule}", "$type": "color", "$description": "Standard hairline border" },
      "focus": { "$value": "{color.focus}", "$type": "color", "$description": "Active focus indicator" }
    },
    "accent": {
      "sky": { "$value": "{color.sky}", "$type": "color", "$description": "Active context and inspectable evidence accent" },
      "sand": { "$value": "{color.sand}", "$type": "color", "$description": "Rare assumption and annotation accent" },
      "pine": { "$value": "{color.pine}", "$type": "color", "$description": "Confirmed evidence or buyer state" },
      "clay": { "$value": "{color.clay}", "$type": "color", "$description": "Unknown, stale, or action-needed state" }
    },
    "feedback": {
      "error": { "$value": "{color.error}", "$type": "color", "$description": "Error, contradiction, and failed recovery state" }
    },
    "motion": {
      "feedbackDuration": { "$value": "{duration.fast}", "$type": "duration", "$description": "Color, border, and opacity response" },
      "transformDuration": { "$value": "{duration.interface}", "$type": "duration", "$description": "Small semantic movement response" },
      "revealDuration": { "$value": "{duration.reveal}", "$type": "duration", "$description": "One-time landing reveal duration" },
      "easeOut": { "$value": "{easing.standard}", "$type": "cubicBezier", "$description": "Shared authored ease-out curve" }
    }
  }
}
