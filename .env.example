# Required server-only application secrets. Generate independent random values;
# never reuse a provider credential for either application secret.
RATE_LIMIT_SECRET=
BUYER_SESSION_SECRET=

# Gemini is server-only. Live is code-pinned to gemini-3.1-flash-live-preview.
# GEMINI_VOICE_MODEL affects only the recorded fallback.
GEMINI_API_KEY=
GEMINI_LIVE_ENABLED=true
LICENSED_SUPPLY_PUBLICATION_ENABLED=false
LICENSED_SUPPLY_PROVIDER_IDS=
GEMINI_VOICE_MODEL=gemini-3.6-flash

# Public product mode. Keep false outside an explicitly labelled demo.
RAMA_DEMO_MODE=false
RAMA_RELEASE_COMMIT=

# Independently reversible Decision OS rollout. Omitted flags default to true;
# set false to fail closed. Cohorts are stable by buyer-session HMAC.
RAMA_PUBLIC_EXPERIENCE_ENABLED=true
RAMA_LANDING_COMPOSITION_ENABLED=true
RAMA_CINEMATIC_HERO_ENABLED=true
RAMA_BRIEF_CONFIRMATION_ENABLED=true
RAMA_EVIDENCE_V2_WRITER_ENABLED=true
RAMA_EVIDENCE_V2_RENDERER_ENABLED=true
RAMA_LOCALE_ROUTES_ENABLED=true
RAMA_DECISION_OS_ROLLOUT_PERCENT=100

# Supabase URL and publishable key are browser-safe by design. The secret key
# is server-only and must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=

# Optional hosted RLS verification identities. Use dedicated disposable test
# accounts in preview/staging only; never production buyers or staff accounts.
RAMA_RLS_TEST_USER_A_EMAIL=
RAMA_RLS_TEST_USER_A_PASSWORD=
RAMA_RLS_TEST_USER_B_EMAIL=
RAMA_RLS_TEST_USER_B_PASSWORD=
RAMA_RLS_TEST_EPHEMERAL=false

# Unapproved future connectors. Leave unset until a reviewed licensed-supply
# agreement and connector profile authorize them.
HOUSECANARY_API_KEY=
HUBSPOT_ACCESS_TOKEN=

# Browser analytics is optional and consent-gated. Server AI observation always
# runs in privacy mode. No transcript, prompt, response, brief, or contact data.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com

# Error monitoring is optional. DSN and client sample rate are public; build
# auth and server sample rate remain server-only. Default trace sampling is 5%.
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=https://0cbf4ccafa4a97dc25dc6be47ae7fc09@o4511937093894144.ingest.de.sentry.io/4511937104773200
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional visual-regression publishing credential, used only in CI/review.
CHROMATIC_PROJECT_TOKEN=

