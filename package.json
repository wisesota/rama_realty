{
  "name": "rama-realty",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "prebuild": "node scripts/build-tokens.mjs && pnpm images:build",
    "pretest": "node scripts/build-tokens.mjs",
    "dev": "next dev --webpack",
    "demo": "node scripts/demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/build-tokens.mjs && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:staging": "playwright test --config playwright.staging.config.ts",
    "e2e:ui": "playwright test --ui",
    "registry:build": "shadcn build registry.json -o public/r",
    "registry:check": "node scripts/verify-registry.mjs",
    "visual:capture": "node scripts/capture-design-evidence.mjs",
    "performance:baseline": "node scripts/capture-performance-baseline.mjs",
    "images:build": "node scripts/build-public-images.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "chromatic:ci": "chromatic --only-changed",
    "verify:gemini-live": "node scripts/verify-gemini-live.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "verify:supabase-identities": "node scripts/verify-supabase-identities.mjs",
    "verify:telemetry": "node scripts/verify-telemetry-providers.mjs",
    "env:check": "node scripts/env-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "release:contract": "node scripts/release-readiness.mjs",
    "release:readiness": "node scripts/release-readiness.mjs --require-production",
    "tokens:check": "node scripts/build-tokens.mjs --check && node scripts/validate-token-usage.mjs",
    "tokens:baseline": "node scripts/validate-token-usage.mjs --write-baseline",
    "tokens:report": "node scripts/validate-token-usage.mjs --write-report",
    "claims:check": "node scripts/verify-public-copy-policy.mjs",
    "check": "pnpm env:check && pnpm release:contract && pnpm tokens:check && pnpm claims:check && pnpm registry:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@posthog/ai": "^8.8.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lottie-react": "^3.1.0",
    "lucide-react": "1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "posthog-js": "^1.418.0",
    "posthog-node": "^5.49.1",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.8.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "chromatic": "^18.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "lighthouse": "13.4.1",
    "postcss": "^8.5.26",
    "puppeteer": "^25.8.0",
    "storybook": "8.6.18",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vercel": "^59.6.2",
    "vite": "^6.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
